# Excel Agent 配置模板
# 用法：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交到仓库）
# 优先级：真实环境变量 > .env 中的值

# ===== 模型配置（三选一）=====

# 智谱 GLM（推荐，glm-5.3-flash 为视觉模型，可直接充当 ReportAgent 的读图模型）
# ZHIPU_API_KEY=
# ZHIPU_MODEL=glm-5.3-flash
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# glm-5.3-flash 无法关闭思考模式，降低推理力度是主要提速手段（low/medium/high/max，不设用服务端默认）
# EXCEL_AGENT_REASONING_EFFORT=low

# 火山方舟 Ark
# ARK_API_KEY=
# ARK_MODEL=
# ARK_BASE_URL=
# ARK_REGION=

# OpenAI 协议兼容接口（OpenAI / DeepSeek 等）
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 兼容接口不支持 json_schema 严格响应时取消注释
# OPENAI_DISABLE_JSON_SCHEMA=true
# 使用 Azure OpenAI 时设为 true
# OPENAI_BY_AZURE=false

# ===== Agent 行为 =====

# 是否给 Executor 配置联网搜索工具（DuckDuckGo），国内网络易超时，可设为 false 关闭
# EXCEL_AGENT_ENABLE_WEB_SEARCH=true
# 模型请求自动重试（撞到 429 限流/网关错误时退避重试，默认开启），设为 false 关闭
# EXCEL_AGENT_MODEL_RETRY=true

# 执行 Python 代码使用的解释器（默认 python，推荐指向虚拟环境，需绝对路径）
# EXCEL_AGENT_PYTHON_EXECUTABLE_PATH=C:\path\to\excel-agent\.venv\Scripts\python.exe

# 附件输入目录（默认 playground/input）
# EXCEL_AGENT_INPUT_DIR=
# 工作目录（默认 playground/<任务id>）
# EXCEL_AGENT_WORK_DIR=

# Windows 下命令执行使用的 shell：powershell（默认）或 cmd
# EXCEL_AGENT_WINDOWS_SHELL=powershell

# ===== 视觉模型（可选，配置后 ReportAgent 才能读图）=====
# ARK_VISION_API_KEY=
# ARK_VISION_MODEL=
# ARK_VISION_BASE_URL=
# ARK_VISION_REGION=

# ===== CozeLoop 全链路追踪（可选）=====
# COZELOOP_WORKSPACE_ID=
# COZELOOP_API_TOKEN=
